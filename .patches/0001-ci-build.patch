From c05e77b29f10b9d2c7c24d86899eaf67f80e87d3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 11:55:46 +0000
Subject: [PATCH] Add GitHub Actions build workflow

Runs npm test on Node 24.x and 22.x with beanstalkd started from
alpine:3.24 on host port 11400, waiting until the container is healthy.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LaHppcejXbSsAH4BZXNsjV
---
 .github/workflows/build.yml | 47 +++++++++++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 .github/workflows/build.yml

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
new file mode 100644
index 0000000..7273a03
--- /dev/null
+++ b/.github/workflows/build.yml
@@ -0,0 +1,47 @@
+name: build
+
+on:
+  push:
+    branches: [master, main]
+  pull_request:
+    branches: [master, main]
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+
+    strategy:
+      matrix:
+        node-version: [24.x, 22.x]
+
+    env:
+      SENECA_TEST_BEANSTALK_HOST: 127.0.0.1
+      SENECA_TEST_BEANSTALK_PORT: 11400
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Use Node.js ${{ matrix.node-version }}
+        uses: actions/setup-node@v4
+        with:
+          node-version: ${{ matrix.node-version }}
+
+      # There is no official beanstalkd image, and service containers cannot
+      # override the image command, so beanstalkd runs from the same Alpine
+      # image and command as docker-compose.yml, with a wait for health.
+      - name: Start beanstalkd
+        run: |
+          docker run -d --name beanstalkd -p 11400:11300 \
+            --health-cmd "nc -z 127.0.0.1 11300" --health-interval 5s \
+            --health-timeout 5s --health-retries 20 \
+            alpine:3.24 sh -c "apk add --no-cache beanstalkd && exec beanstalkd -l 0.0.0.0 -p 11300"
+          for i in $(seq 1 60); do
+            [ "$(docker inspect -f '{{.State.Health.Status}}' beanstalkd)" = healthy ] && exit 0
+            sleep 2
+          done
+          docker logs beanstalkd
+          exit 1
+
+      - run: npm install
+      - run: npm run build --if-present
+      - run: npm test
